<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/home_scroll_view" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background_light">
<LinearLayout android:id="@+id/main_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/home_title_text_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_display_name" android:textSize="20sp" android:textColor="@color/text_primary" android:textStyle="bold" android:accessibilityHeading="true" android:layout_marginBottom="16dp"/>
<com.ciblorenzo.whatsonmyfood.ui.AdaptiveColumns android:layout_width="match_parent" android:layout_height="wrap_content">
<com.google.android.material.card.MaterialCardView style="@style/ProductCard" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/ui_hero_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_hero_title" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold"/>
<TextView android:id="@+id/ui_hero_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_hero_body" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"/>
<Button android:id="@+id/action_scan" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_scan_product"/><Button android:id="@+id/action_ingredients" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_scan_ingredients"/>
</LinearLayout></com.google.android.material.card.MaterialCardView>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView style="@style/SectionHeader" android:text="@string/quick_actions"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
<Button android:id="@+id/action_pantry" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="104dp" android:paddingHorizontal="4dp" android:layout_marginEnd="8dp" android:textSize="13sp" android:text="@string/pantry" app:icon="@drawable/ic_pantry" app:iconGravity="textTop" app:iconPadding="8dp"/>
<Button android:id="@+id/action_database" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="104dp" android:paddingHorizontal="4dp" android:layout_marginEnd="8dp" android:textSize="13sp" android:text="@string/ingredient_db_home" app:icon="@drawable/ic_database" app:iconGravity="textTop" app:iconPadding="8dp"/>
<Button android:id="@+id/action_history" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="104dp" android:paddingHorizontal="4dp" android:textSize="13sp" android:text="@string/ui_history" app:icon="@android:drawable/ic_menu_recent_history" app:iconGravity="textTop" app:iconPadding="8dp"/>
</LinearLayout></LinearLayout></com.ciblorenzo.whatsonmyfood.ui.AdaptiveColumns>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView style="@style/SectionHeader" android:layout_width="0dp" android:layout_weight="1" android:text="@string/recommended_swaps"/>
<Button android:id="@+id/view_all_swaps" style="@style/SourceLink" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_view_all"/>
</LinearLayout>
<com.ciblorenzo.whatsonmyfood.ui.ContentStateView android:id="@+id/swaps_state" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/recommendations_recycler_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
<TextView android:id="@+id/history_heading" style="@style/SectionHeader" android:text="@string/ui_recent_scans"/>
<TextView android:id="@+id/history_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_history_note" android:textSize="12sp" android:textColor="@color/text_primary" />
<com.ciblorenzo.whatsonmyfood.ui.ContentStateView android:id="@+id/history_state" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
<TextView style="@style/SectionHeader" android:text="@string/daily_health_tip"/>
<TextView android:id="@+id/daily_tip_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/daily_health_tip" android:textSize="16sp" android:textColor="@color/text_primary" /><TextView android:id="@+id/daily_tip_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/daily_health_tip" android:textSize="12sp" android:textColor="@color/text_primary" android:layout_marginTop="8dp"/>
</LinearLayout></androidx.core.widget.NestedScrollView>
